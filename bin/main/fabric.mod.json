{
	"schemaVersion": 1,
	"id": "lighthlib",
	"version": "${mod_version}",
	"name": "LightHLib",
	"description": "A 16-bit light channel library: breaks the vanilla 15-level light system and raises the block-light ceiling of every dimension to 65535 levels. Provides the HLIGHT/HlightLevel/HLightColor block-light component API for mod developers, an internal 16-bit light field engine (LHCE), a colored-light approximation layer, debug commands and a test block.",
	"authors": [
		"Chnets Ella"
	],
	"contact": {
		"homepage": "https://github.com/lighthlib/lighthlib",
		"sources": "https://github.com/lighthlib/lighthlib"
	},
	"license": "MIT",
	"icon": "assets/lighthlib/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.lighthlib.LightHLib"
		],
		"client": [
			"com.lighthlib.client.LightHLibClient"
		],
		"modmenu": [
			"com.lighthlib.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"lighthlib.mixins.json",
		{
			"config": "lighthlib.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "lighthlib.compat.mixins.json",
			"environment": "client"
		}, ${flavor_mixins}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"breaks": ${flavor_breaks}
}
